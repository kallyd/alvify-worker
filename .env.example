# Copy this file to .env and fill in values for your deployment

# Alvify API base URL — use the dedicated workers subdomain for remote deployments
# (Cloudflare proxies HTTPS, so use https:// when connecting from the internet)
API_URL=https://workers.alvify.com.br

# Worker ID — the UUID generated in the Admin > Workers panel
WORKER_ID=

# API Key — shown once when the worker was created in the admin panel
WORKER_API_KEY=

# Maximum number of jobs this worker processes in parallel
MAX_CONCURRENCY=2

# Browser pool slots — each slot ≈ 150-250 MB RAM (with resource blocking ~100-150 MB)
# Rule of thumb: slots = MAX_CONCURRENCY × 3 (if RAM allows)
MAX_BROWSER_SLOTS=6

# Worker version string (displayed in admin panel)
VERSION=1.0.0

# Horizontal scaling: run multiple workers (different WORKER_ID) on the same
# or different machines. The Redis BLPOP queue distributes jobs automatically.
# Each worker should have its own WORKER_ID + WORKER_API_KEY pair.

# HTTP port for the /health ping endpoint (default 8001)
HEALTH_PORT=8001

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Redis URL — enables 7-day place cache (skips re-scraping known places)
# For docker-compose local dev: redis://redis:6379/0
REDIS_URL=

# ── CNPJ API Integration (api-db) ──────────────────────────────────────────────
# Base URL of the Alvify CNPJ database API
CNPJ_API_URL=https://api-cnpj.alvify.com.br

# API key for authentication (leave empty if auth is disabled on the API)
CNPJ_API_KEY=

# Enable hybrid enrichment: cross-reference Google Maps leads with CNPJ data
CNPJ_ENRICHMENT_ENABLED=true

# Timeout in seconds for CNPJ API calls (per request)
CNPJ_ENRICHMENT_TIMEOUT=5

# ── Quality & Dedup Settings ────────────────────────────────────────────────────
# Enable cross-job deduplication via Redis (30-day TTL)
GLOBAL_DEDUP_ENABLED=true

# Minimum quality score (0-100) for a lead to be submitted. Leads below this are dropped.
QUALITY_SCORE_MIN=20

# Grid search threshold: use geographic grid when max_results exceeds this value
GRID_SEARCH_THRESHOLD=60

# ── Instagram Discovery ─────────────────────────────────────────────────────────
# Enable Instagram profile discovery via DuckDuckGo/Bing search.
# DISABLED by default — requires residential proxy or non-datacenter IP.
# Sources that already work without this: Google Maps link + website HTML extraction.
INSTAGRAM_DISCOVERY_ENABLED=false

# Delay between searches (seconds) — higher = less chance of being blocked
INSTAGRAM_SEARCH_DELAY=5

# ── Instagram Discovery via LLM (OpenRouter) ────────────────────────────────────
# Uses AI to find Instagram handles for businesses. Works from any IP.
# Uses Gemini 3.5 Flash (~$0.0015/1K tokens — pennies per batch of 10 leads).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
