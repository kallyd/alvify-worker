# Copy this file to .env and fill in values for your deployment

# Alvify API base URL — use the dedicated workers subdomain for remote deployments
# (Cloudflare proxies HTTPS, so use https:// when connecting from the internet)
API_URL=https://workers.alvify.com.br

# Worker ID — the UUID generated in the Admin > Workers panel
WORKER_ID=

# API Key — shown once when the worker was created in the admin panel
WORKER_API_KEY=

# Maximum number of jobs this worker processes in parallel
MAX_CONCURRENCY=2

# Worker version string (displayed in admin panel)
VERSION=1.0.0

# HTTP port for the /health ping endpoint (default 8001)
HEALTH_PORT=8001

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
