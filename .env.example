# Copy this file to .env and fill in values for your deployment

# Alvify API base URL — use the dedicated workers subdomain for remote deployments
# (Cloudflare proxies HTTPS, so use https:// when connecting from the internet)
API_URL=https://workers.alvify.com.br

# Worker ID — the UUID generated in the Admin > Workers panel
WORKER_ID=

# API Key — shown once when the worker was created in the admin panel
WORKER_API_KEY=

# Maximum number of jobs this worker processes in parallel
MAX_CONCURRENCY=2

# Browser pool slots — each slot ≈ 150-250 MB RAM (with resource blocking ~100-150 MB)
# Rule of thumb: slots = MAX_CONCURRENCY × 3 (if RAM allows)
MAX_BROWSER_SLOTS=6

# Worker version string (displayed in admin panel)
VERSION=1.0.0

# Horizontal scaling: run multiple workers (different WORKER_ID) on the same
# or different machines. The Redis BLPOP queue distributes jobs automatically.
# Each worker should have its own WORKER_ID + WORKER_API_KEY pair.

# HTTP port for the /health ping endpoint (default 8001)
HEALTH_PORT=8001

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Redis URL — enables 7-day place cache (skips re-scraping known places)
# For docker-compose local dev: redis://redis:6379/0
REDIS_URL=
